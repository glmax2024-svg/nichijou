generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FAN
  CREATOR
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum OrderType {
  BIRTHDAY
  WAKE_UP
  CUSTOM
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELED
}

enum LoraStatus {
  NONE
  QUEUED
  TRAINING
  READY
  FAILED
}

enum VoiceProfileStatus {
  PENDING
  ENROLLING
  READY
  FAILED
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String         @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            UserRole       @default(FAN)
  bio             String?        @db.Text
  birthDate       DateTime?      @db.Date
  ageVerifiedAt   DateTime?
  termsAcceptedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        Account[]
  sessions        Session[]
  characters      Character[]
  subscriptions   Subscription[]
  messages        Message[]
  gifts           Gift[]
  orders          Order[]
  postComments    PostComment[]
  postLikes       PostLike[]
  memories          CharacterMemory[]
  bonds             CharacterBond[]
  creatorShareBps   Int?
  earnings          CreatorEarning[]
  inviteCodeId      String?
  inviteCode        InviteCode?    @relation(fields: [inviteCodeId], references: [id], onDelete: SetNull)
  mediaAssets       MediaAsset[]
  /// 金币余额（目前没有充值，注册时发放初始金币）。只能通过 src/lib/coins.ts 变更，保证与流水一致
  coinBalance       Int            @default(0)
  /// 上次打开通知页的时间；晚于它的通知算未读
  notificationsSeenAt DateTime?
  coinTransactions  CoinTransaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Character {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  tagline           String?
  avatarUrl         String
  coverUrl          String?
  bio               String         @db.Text
  personality       String         @db.Text
  speechStyle       String         @db.Text
  tags              String         @default("")
  identity          String         @default("") @db.Text
  worldRules        String         @default("") @db.Text
  brandVoice        String         @default("") @db.Text
  boundaries        String         @default("") @db.Text
  /// 第一次聊天时角色说的第一句话（按人设与口吻撰写）；为空时使用通用开场白
  greeting          String         @default("") @db.Text
  contentRating     String         @default("ALL")
  personaVersion    Int            @default(1)
  triggerWord       String?
  skillIds          String         @default("")
  voiceId           String         @default("default")
  loraAdapterId     String?
  loraStatus        LoraStatus     @default(NONE)
  loraVersion       Int            @default(0)
  voiceEmbeddingId  String?
  subscriptionPrice Int            @default(980)
  published         Boolean        @default(false)
  creatorId         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  creator           User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  posts             Post[]
  subscriptions     Subscription[]
  messages          Message[]
  gifts             Gift[]
  orders            Order[]
  voiceClips        VoiceClip[]
  voiceProfile      VoiceProfile?
  memories          CharacterMemory[]
  loraJobs          LoraTrainingJob[]
  loraGenerations   LoraGeneration[]
  personaRevisions  PersonaRevision[]
  bonds             CharacterBond[]
  creatorShareBps   Int?
  /// 从外部 LoRA 目录导入时的角色基名（如 emilia_re_zero），导入脚本据此判断是否已导入
  /// female | male | other —— 发现页按性别筛选
  gender            String?
  catalogLoraBase   String?
  /// original = 原创；existing = 现有作品角色；null = 来源未确认。非原创角色上线前需要确认授权
  ipOrigin          String?
  ipSourceWork      String?
  earnings          CreatorEarning[]
  mediaAssets       MediaAsset[]
  /// 「いまの様子」：画师在工作室设置，过期后不再显示
  statusEmoji       String?
  statusText        String?
  statusUpdatedAt   DateTime?
  statusExpiresAt   DateTime?

  @@index([catalogLoraBase])
}

model Post {
  id            String        @id @default(cuid())
  characterId   String
  content       String        @db.Text
  imageUrl      String?
  isAiAssisted  Boolean       @default(false)
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  character     Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  comments      PostComment[]
  likes         PostLike[]
}

model PostComment {
  id            String   @id @default(cuid())
  postId        String
  userId        String?
  authorType    String
  content       String   @db.Text
  isAiGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  characterId          String
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  character            Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Message {
  id            String    @id @default(cuid())
  userId        String
  characterId   String
  role          String
  content       String    @db.Text
  isAiGenerated Boolean   @default(false)
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, createdAt])
}

model Gift {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  giftType    String
  amount      Int
  message     String?
  stripeSessionId String? @unique
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  characterId String
  type        OrderType
  status      OrderStatus @default(PENDING)
  amount      Int
  scheduledAt DateTime?
  content     String?   @db.Text
  voiceUrl    String?
  voiceAssetId String?
  voiceAsset   MediaAsset? @relation("OrderVoiceAsset", fields: [voiceAssetId], references: [id], onDelete: SetNull)
  stripeSessionId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model VoiceClip {
  id          String    @id @default(cuid())
  characterId String
  label       String
  text        String
  audioUrl    String?
  audioAssetId String?
  audioAsset   MediaAsset? @relation("VoiceClipAudioAsset", fields: [audioAssetId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

/// 5 秒声纹采集 — TTS 克隆声线
model VoiceProfile {
  id             String             @id @default(cuid())
  characterId    String             @unique
  sampleAudioUrl String
  durationSec    Float
  embeddingId    String?
  status         VoiceProfileStatus @default(PENDING)
  enrolledAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  character      Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

/// LoRA 训练任务 — 角色形象 / 人设微调
model LoraTrainingJob {
  id          String     @id @default(cuid())
  characterId String
  status      LoraStatus @default(QUEUED)
  adapterId   String?
  datasetNote String?    @db.Text
  /// 0–100 训练进度（画师页轮询展示）
  progress    Int        @default(0)
  triggerWord String?
  baseModel   String?
  recipeJson  String?    @db.Text
  errorMsg    String?    @db.Text
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime   @default(now())
  /// anima = 外部训练服务；空 = 旧的本地 worker / 模拟训练
  provider           String?
  /// 训练服务侧的任务 id
  remoteJobId        String?
  /// 训练服务侧的角色名（nj_<characterId>），同一角色多次训练共用，版本递增
  remoteCharacter    String?
  /// 提交时的幂等键（32 位十六进制），重试复用
  requestKey         String?
  /// 训练服务的原始状态（tagging / waiting_gpu / generating_previews ...）
  remoteStatus       String?
  revision           Int?
  /// 固定版本的 LoRA id（nj_xxx__v2）。角色引用它而不是别名，重训不会悄悄改变已发布角色的长相
  loraId             String?
  readyForGeneration Boolean   @default(false)
  step               Int?
  totalSteps         Int?
  queuePosition      Int?
  errorCode          String?
  imageCount         Int?
  duplicatesRemoved  Int?
  /// [{ angle, assetId, url }]，三个角度的预览图（已转存到自己的存储）
  previews           Json?
  trainingStartedAt  DateTime?
  /// 画师把这个版本设为角色当前使用版本的时间
  activatedAt        DateTime?
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([remoteJobId])
}

/// LoRA 生成结果 — 画师用已训练 adapter 出图 / 出文案
model LoraGeneration {
  id             String    @id @default(cuid())
  characterId    String
  prompt         String    @db.Text
  negativePrompt String?   @db.Text
  imageUrl       String?
  assetId        String?
  asset          MediaAsset? @relation("LoraGenerationAsset", fields: [assetId], references: [id], onDelete: SetNull)
  textContent    String?   @db.Text
  weight         Float     @default(0.85)
  steps          Int       @default(28)
  status         String    @default("READY")
  createdAt      DateTime  @default(now())
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, createdAt])
}

/// 人格容器版本回溯 — 每次 Studio 保存人设时落一版
model PersonaRevision {
  id          String    @id @default(cuid())
  characterId String
  version     Int
  payload     Json
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, version])
  @@index([characterId, createdAt])
}

/// 用户 × 角色关系快照（可回放）
model CharacterBond {
  id              String              @id @default(cuid())
  userId          String
  characterId     String
  intimacy        Int                 @default(0)
  stage           String              @default("new")
  turnCount       Int                 @default(0)
  summary         String              @default("") @db.Text
  lastUserMessage String              @default("") @db.Text
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  character       Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  events          CharacterBondEvent[]

  @@unique([userId, characterId])
}

model CharacterBondEvent {
  id            String        @id @default(cuid())
  bondId        String
  type          String
  summary       String        @db.Text
  deltaIntimacy Int           @default(0)
  createdAt     DateTime      @default(now())
  bond          CharacterBond @relation(fields: [bondId], references: [id], onDelete: Cascade)

  @@index([bondId, createdAt])
}

/// 永久记忆 — Memos 插件本地镜像 / 降级存储
model CharacterMemory {
  id          String    @id @default(cuid())
  userId      String
  characterId String
  content     String    @db.Text
  category    String    @default("general")
  source      String    @default("memos")
  importance  Float     @default(0.5)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId])
}

/// AI 用量记账 — 成本控制的度量层（每次 gateway 调用一行）
model AiUsageLog {
  id           String   @id @default(cuid())
  scene        String
  tier         String
  model        String
  protocol     String
  userId       String?
  characterId  String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  latencyMs    Int      @default(0)
  ok           Boolean  @default(true)
  errorMsg     String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([scene, createdAt])
  @@index([model, createdAt])
}

/// 平台键值设置（全局画师分成等）
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// 限时分成活动：给画师份额加成（basis points，1000 = +10%）
model RevenueCampaign {
  id          String   @id @default(cuid())
  name        String
  bonusBps    Int
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  /// GLOBAL | CREATOR | CHARACTER
  scope       String   @default("GLOBAL")
  creatorId   String?
  characterId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

/// 画师收入账本。每笔已入账支付一行，分成快照不可回溯改写。
model CreatorEarning {
  id              String    @id @default(cuid())
  creatorId       String
  characterId     String
  /// SUBSCRIPTION | GIFT | ORDER
  kind            String
  sourceId        String    @unique
  grossAmount     Int
  creatorShareBps Int
  bonusBps        Int       @default(0)
  finalShareBps   Int
  creatorAmount   Int
  platformAmount  Int
  campaignId      String?
  campaignName    String?
  /// PENDING | AVAILABLE | PAID_OUT
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  creator         User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
  @@index([characterId, createdAt])
}

/// 后台可配置的礼物图录（icon / 动画 / 价格）
model GiftItem {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  emoji         String   @default("🎁")
  iconUrl       String?
  animationUrl  String?
  /// none | gif | mp4
  animationKind String   @default("none")
  amount        Int
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  intimacyDelta Int      @default(3)
  description   String   @default("")
  accentColor   String   @default("#ffe1e6")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}

enum BetaApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// 内测申请。按邮箱去重：同一邮箱重复提交时更新待审核的那条。
model BetaApplication {
  id           String                @id @default(cuid())
  email        String
  nickname     String
  /// FAN | CREATOR —— 申请人自报，审核时可以改
  userType     UserRole              @default(FAN)
  twitterUrl   String?
  pixivUrl     String?
  /// LINE | DISCORD | X_DM | OTHER
  contactType  String
  contactValue String
  intro        String                @db.Text
  status       BetaApplicationStatus @default(PENDING)
  reviewNote   String?               @db.Text
  reviewedAt   DateTime?
  reviewedById String?
  inviteCode   InviteCode?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// 邀请码。email 非空时只允许该邮箱注册；grantRole 决定注册后的身份。
model InviteCode {
  id            String           @id @default(cuid())
  code          String           @unique
  note          String?
  grantRole     UserRole         @default(FAN)
  email         String?
  maxUses       Int              @default(1)
  usedCount     Int              @default(0)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdById   String?
  applicationId String?          @unique
  application   BetaApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  users         User[]
  createdAt     DateTime         @default(now())

  @@index([createdAt])
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
}

enum MediaVisibility {
  /// CDN 直出，可长期缓存（头像、封面、公开动态配图）
  PUBLIC
  /// 只存 key，访问要经过 /api/media/[id] 鉴权（付费语音、私聊里的图）
  PRIVATE
}

/// 所有二进制产物的统一记录。业务表只引用 id，不再存完整 URL。
model MediaAsset {
  id          String          @id @default(cuid())
  kind        MediaKind
  visibility  MediaVisibility @default(PUBLIC)
  /// 对象存储里的 key，不含域名 —— 换 CDN / 换域名不需要改数据
  storageKey  String          @unique
  contentType String
  bytes       Int
  width       Int?
  height      Int?
  durationMs  Int?
  /// 内容哈希，用于去重与校验
  sha256      String
  /// anima | zetta | gateway | upload
  source      String
  /// prompt、lora、seed、模型版本等，便于复现和排查
  sourceMeta  Json?
  characterId String?
  character   Character?      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// 仅属于某个用户的内容才有值；删除用户数据时按此清理
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())

  loraGenerations LoraGeneration[] @relation("LoraGenerationAsset")
  orders          Order[]          @relation("OrderVoiceAsset")
  voiceClips      VoiceClip[]      @relation("VoiceClipAudioAsset")

  @@index([userId, createdAt])
  @@index([characterId, createdAt])
  @@index([sha256])
}

/// 训练次数计费记录。不挂外键：删除角色后仍然计入当月额度，防止「删了再建」刷次数。
model LoraTrainingCharge {
  id          String   @id @default(cuid())
  creatorId   String
  characterId String
  jobId       String   @unique
  createdAt   DateTime @default(now())

  @@index([creatorId, createdAt])
}

/// 远端清理失败时留下的待办（例如删除角色时训练任务还没结束），之后重试
model PendingRemoteDeletion {
  id          String   @id @default(cuid())
  kind        String
  remoteId    String   @unique
  attempts    Int      @default(0)
  lastError   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 金币流水。每一笔余额变化都对应一条记录，balanceAfter 便于对账。
model CoinTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 正数为收入，负数为支出
  delta        Int
  balanceAfter Int
  /// signup_bonus | gift | admin_adjust ...
  reason       String
  /// 关联对象（如礼物 id），用于幂等与追溯
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([reason, refType, refId])
}

/// 运营活动（首页横幅）。published 且当前时间在 startsAt..endsAt 之间才展示
model PlatformEvent {
  id          String   @id @default(cuid())
  title       String
  subtitle    String   @default("")
  description String   @default("") @db.Text
  badge       String   @default("期間限定イベント")
  /// 横幅配色，见 src/lib/event-themes.ts
  theme       String   @default("sakura")
  imageUrl    String?
  /// 站内路径（/characters/xxx）或 https 链接；为空时按钮进活动详情页
  linkHref    String?
  ctaLabel    String   @default("詳しく見る")
  startsAt    DateTime
  endsAt      DateTime
  published   Boolean  @default(false)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, startsAt, endsAt])
}
