# 生产环境变量模板。复制为 deploy/.env.production 填好后，用 deploy.sh --env 上传。
# deploy/.env.production 被 .gitignore 的 .env* 规则忽略，不会提交。

# —— 运行模式 ——
NICHJOU_DEMO_MODE="false"
# 内测邀请制（整站需登录，注册需邀请码）
NICHIJOU_INVITE_ONLY="true"

# —— 数据库（Postgres 跑在同一台机器的 Docker 里）——
DB_PASSWORD="<openssl rand -hex 24 生成>"
DATABASE_URL="postgresql://nichijou:<同上>@127.0.0.1:5432/nichijou"

# —— 登录 ——
AUTH_URL="https://<你的域名>"
AUTH_TRUST_HOST="true"
AUTH_SECRET="<openssl rand -base64 32 生成，不要复用本地的>"

# —— 对象存储 Cloudflare R2（必填，否则生图/上传会失败）——
# 两个桶都不开公开访问：公开图片由网站的 /media/ 路由转发，私有文件由 /api/media/<id> 鉴权后发临时链接
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_BUCKET="nichijou-media"
S3_PRIVATE_BUCKET="nichijou-private"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# 以后给公开桶接 CDN 时再填（两个值相同）；留空 = 由网站转发
S3_PUBLIC_BASE_URL=""
NEXT_PUBLIC_MEDIA_BASE_URL=""

# —— LLM 网关（从本地 .env 复制）——
AI_GATEWAY_BASE_URL=""
AI_GATEWAY_API_KEY=""
AI_MODEL_NANO=""
AI_MODEL_FAST=""
AI_MODEL_BALANCED=""
AI_MODEL_FLAGSHIP=""
AI_MODEL_IMAGE=""

# —— 生图 / 语音（上线前请换新 key）——
ANIMA_API_URL="https://13-59-240-119.sslip.io/api/image"
ANIMA_API_KEY=""
ZETTA_API_URL="https://13-59-240-119.sslip.io"
ZETTA_API_KEY=""

# —— 支付（暂不配置：订阅/订单会显示未开通）——
STRIPE_SECRET_KEY=""
