DATABASE_URL="postgresql://nichijou:nichijou@localhost:5432/nichijou"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret"
AUTH_URL="http://localhost:3100"

# true = 允许模拟训练 / 免费开通订阅等。production 默认 false；本地开发默认 true
NICHJOU_DEMO_MODE="true"

# OpenAI — character chat & daily drafts
OPENAI_API_KEY=""

# Stripe — 先用测试钥（sk_test_ / pk_test_）。Webhook：checkout.session.completed → /api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional: ElevenLabs TTS (falls back to OpenAI TTS)
ELEVENLABS_API_KEY=""

# ── Nichijou AI 底层 ──

# Memos Worker（独立进程）。本地：npm run worker:memos
MEMOS_API_URL="http://127.0.0.1:3220"
MEMOS_API_KEY="dev-memos-worker"
MEMOS_RETENTION_DAYS="365"

# LoRA Worker（独立进程）。本地：npm run worker:lora
# LORA_WORKER_API_KEY 与下面两把 key 保持一致
LORA_TRAINING_API_URL="http://127.0.0.1:3200"
LORA_TRAINING_API_KEY="dev-lora-worker"
LORA_INFERENCE_API_URL="http://127.0.0.1:3200"
LORA_INFERENCE_API_KEY="dev-lora-worker"

# Voice Worker（独立进程）。本地：npm run worker:voice
TTS_CLONE_API_URL="http://127.0.0.1:3210"
TTS_CLONE_API_KEY="dev-voice-worker"

# ── AI 网关（中转站）— 统一入口，见 docs/AI_ROUTING.md ──
AI_GATEWAY_BASE_URL="https://api.develop.cc"
AI_GATEWAY_API_KEY=""
# 留空=按模型名自动选协议；填 openai/anthropic/gemini 可全局强制
AI_GATEWAY_PROTOCOL=""
AI_GATEWAY_ANTHROPIC_VERSION="2023-06-01"
AI_GATEWAY_TIMEOUT_MS="30000"
AI_GATEWAY_MAX_RETRIES="2"

# 成本分档模型
AI_MODEL_NANO=""        # 最便宜：评论回复、审核判定
AI_MODEL_FAST=""        # 便宜：免费用户聊天、LoRA 配套文案
AI_MODEL_BALANCED=""    # 中档：订阅用户聊天、SNS 文案草稿
AI_MODEL_FLAGSHIP=""    # 旗舰：付费订单文案、订阅用户塔罗长文
AI_MODEL_IMAGE=""       # 生图兜底（留空=只走自建 LoRA）
AI_MODEL_TTS="tts-1"
AI_TTS_VOICE="nova"

# 对象存储（Cloudflare R2 / AWS S3 / OSS 兼容）。生产必须配置；Demo 未配置时写本地 public/uploads
# R2：Dashboard → R2 → Create bucket `nichijou` → Settings 开启 Public r2.dev
#     → Manage R2 API Tokens → Create API token（Object Read & Write）
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_BUCKET="nichijou"
# S3_REGION="auto"
# S3_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# 预算守卫 & 临时改档
AI_DAILY_OUTPUT_TOKEN_BUDGET="0"
AI_SCENE_TIER_OVERRIDES=""

# 法律表記（特定商取引法・プライバシー）。公開前に実名・住所を入れる
LEGAL_OPERATOR_NAME=""
LEGAL_OPERATOR_REPRESENTATIVE=""
LEGAL_OPERATOR_ADDRESS=""
LEGAL_OPERATOR_EMAIL="support@nichijou.app"
LEGAL_OPERATOR_PHONE=""
LEGAL_PRICE_NOTE=""
