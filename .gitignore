# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# LoRA 训练上传与生成图（保留目录）
/public/uploads/lora/**
!/public/uploads/lora/.gitkeep
/public/uploads/posts/**
!/public/uploads/posts/.gitkeep
/public/uploads/generated/**
!/public/uploads/generated/.gitkeep

# sqlite
*.db
*.db-journal
prisma/dev.db
prisma/dev.db-journal

# android
android/local.properties
android/.gradle/
android/**/build/
android/**/*.iml
android/.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
